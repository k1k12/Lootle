{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lootle",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  // Serve only on the real domain: no workers.dev address, no preview links.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "lootle.app", "custom_domain": true },
    { "pattern": "www.lootle.app", "custom_domain": true }
  ],
  // Everything in ./public is served as static files. Only /api/* runs the Worker.
  "assets": { "directory": "./public" },
  // One small SQLite-backed store per safe. Created automatically on first deploy.
  "durable_objects": {
    "bindings": [
      { "name": "SEAM", "class_name": "SeamStore" },
      // One store per player: their stash, items and which safes have paid out.
      { "name": "PLAYER", "class_name": "PlayerStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SeamStore"] },
    { "tag": "v2", "new_sqlite_classes": ["PlayerStore"] }
  ],
  // Rate limits (counted per Cloudflare location, so treat them as approximate).
  "ratelimits": [
    { "name": "LIMIT_IP", "namespace_id": "4101", "simple": { "limit": 300, "period": 60 } },
    { "name": "LIMIT_ANSWER", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
